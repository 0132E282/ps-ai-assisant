# AI Provider Configuration
AI_PROVIDER=gemini  # Options: gemini, openai, claude, llama

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
CLAUDE_API_KEY=your_claude_api_key_here

# LLaMA Configuration
LLAMA_PROVIDER=ollama  # Options: ollama (local), groq (cloud)
LLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
DB_TYPE=sqlite  # Options: sqlite, mysql
DATABASE_URL=sqlite:///./bot_system.db

# Text-to-Speech (TTS)
TTS_ENGINE=pygame  # Options: pygame, macos

# Speech Recognition
STT_ENGINE=google  # Options: google, gemini
